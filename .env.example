# ==========================================
# MINI CAAS PLATFORM - ENVIRONMENT CONFIG
# ==========================================

# Application Ports (Isolated from Hotel Booking 3000/8080/5432)
FRONTEND_PORT=5173
BACKEND_PORT=8088
DB_PORT=5433

# Database Settings (PostgreSQL 16)
DB_HOST=localhost
DB_NAME=minicaas
DB_USER=minicaas_admin
DB_PASSWORD=minicaas_secure_pass_2026

# Spring Security & JWT
JWT_SECRET=MiniCaaSSecretKeyForDemoProjectAuthentication2026MustBeAtLeast32Bytes
JWT_EXPIRATION_MS=86400000

# Kubernetes Cluster Configuration
K8S_CLUSTER_NAME=caas-cluster
K8S_DEFAULT_NAMESPACE=default
